# --- Interns Ledger server configuration (no secrets committed; see NFR-MNT-02) ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/interns_ledger
JWT_SECRET=change-me-32-chars-minimum-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
INSTITUTION_EMAIL_DOMAIN=st.umat.edu.gh
INSTITUTION_NAME=University of Mines and Technology
APP_TIMEZONE=Africa/Accra
CLIENT_ORIGIN=http://localhost:5173
# Email (Resend). Leave RESEND_API_KEY empty in dev to log emails to console instead.
RESEND_API_KEY=
EMAIL_FROM=Interns Ledger <onboarding@resend.dev>
# Attachments (Vercel Blob). Empty = attachment uploads disabled in this environment.
BLOB_READ_WRITE_TOKEN=
# Sprint 3+: ED25519_PRIVATE_KEY (PEM) — env-injected, never in DB or VCS (NFR-SEC-04)
